# Optional server configuration. npm start and npm run dev load .env automatically.
# Keep .env local; never use VITE_ prefixes for secrets. All integrations work in demo mode without keys.
# Existing Docker Compose domain setting; changing this file does not deploy anything.
DOMAIN=orbita.example.org

# Local app defaults. npm run dev keeps the API on 3001 for the Vite proxy.
PORT=3001
# DATABASE_PATH=./data/orbita.sqlite
# Leave APP_ORIGIN unset for local development. For an external address use its exact HTTPS origin.
# APP_ORIGIN=https://your-domain.example
COOKIE_SECURE=false
TRUST_PROXY=0

# Optional Sber GigaChat authorization key (Base64 value from the GigaChat API dashboard).
# Both credentials and a scope are required. GigaChat takes precedence over Yandex.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Model defaults to GigaChat-3-Pro. Use an exact model ID available to this API project.
# GIGACHAT_MODEL=GigaChat-3-Ultra
# Local runtime PEM containing trusted CA certificates, stored outside the repository.
# GIGACHAT_CA_FILE=/absolute/path/to/gigachat-ca.pem
# For Compose with compose.gigachat-ca.yaml, set the readable host path instead.
# GIGACHAT_CA_HOST_FILE=/absolute/path/to/gigachat-ca.pem

# Optional Yandex AI. Fill all three values to enable external requests.
# Questions and necessary retrieved fragments then leave this server for Yandex AI.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Copy a model URI available in your own Yandex catalog; do not invent a folder ID/model.
YANDEX_MODEL_URI=

# Telegram: bot username without @. Register the HTTPS webhook separately.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random 16-256 characters, A-Z a-z 0-9 _ -.
TELEGRAM_WEBHOOK_SECRET=

# VK community messages + Callback API; positive numeric group ID.
VK_GROUP_TOKEN=
VK_GROUP_ID=
# Random secret of at least 16 characters.
VK_WEBHOOK_SECRET=
VK_CONFIRMATION_TOKEN=
VK_API_VERSION=5.199
# Shared public demo accounts: live pairing is deliberately disabled by default.
ALLOW_REAL_CHANNEL_LINKING=false

# Local fictional payment; no bank card is collected.
PAYMENTS_MODE=demo
# Optional adapter: PAYMENTS_MODE=yookassa-test, test-shop credentials ONLY.
YOOKASSA_SHOP_ID=
# This adapter conservatively requires a test_ prefix and verifies response.test === true.
YOOKASSA_SECRET_KEY=
# HTTPS return URL of this app, for example https://your-domain.example/#housing.
# Returning here does not mark an invoice paid; the server verifies the provider status.
YOOKASSA_RETURN_URL=

# MCP stdio bridge settings belong to the local AI client's protected environment.
# The bridge does not load this .env automatically; do not put a personal token in shared server config.
# ORBITA_MCP_URL=http://127.0.0.1:3001/mcp
# ORBITA_MCP_TOKEN=
