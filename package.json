{
  "name": "orbita-student-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Орбита — конкурсный концепт цифрового деканата на вымышленных данных",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run build && npm test && npm run test:e2e",
    "report": "node scripts/prepare-report.mjs",
    "mcp:stdio": "node scripts/mcp-stdio.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pdf-parse": "2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.0.0",
    "marked": "^18.2.0",
    "prettier": "^3.10.1",
    "vite": "^7.1.0"
  }
}
