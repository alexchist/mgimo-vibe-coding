    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.0.0",
    "marked": "^18.2.0",
    "vite": "^7.1.0"
  }
